{
  "name": "nikita-sofia-invite",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000 -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run",
    "test:smoke": "playwright test --project=mobile-chromium",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "bot:poll": "node scripts/telegram-polling.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "motion": "^12.38.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^26.0.0",
    "lighthouse": "^13.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
